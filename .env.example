# Copie para .env e ajuste conforme o ambiente.

# Banco SQLite: ":memory:" (padrão) ou caminho de arquivo, ex.: ./wallet.db
DATABASE_URL=:memory:

# Webhook do gateway anti-fraude fictício. Vazio = apenas registra em log.
ANTIFRAUD_WEBHOOK_URL=
ANTIFRAUD_TIMEOUT_SECONDS=2.0

# Limite máximo por transferência (em reais)
MAX_TRANSFER_AMOUNT=100000.00

LOG_LEVEL=INFO
